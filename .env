# ====== MAJBURIY ======
# @BotFather bergan token (bu faylni .env nomi bilan nusxalab, shu yerga yozing)
BOT_TOKEN=8869945197:AAEtmSVgnLGyriBrPyQKGWOhxBViL_Ue9sw
# ====== ISHLASH REJIMI ======
# polling  - Windows kompyuteringizda (oddiy, internet yetarli)
# webhook  - web-service turidagi hostingda (WEBHOOK_URL kerak)
BOT_MODE=polling

# Faqat webhook rejimida: hosting bergan https manzil, masalan https://mening-botim.onrender.com
WEBHOOK_URL=
# Faqat webhook rejimida: o'zingiz o'ylab topgan uzun maxfiy qator (harf, raqam, _ va -)
WEBHOOK_SECRET=
# Hosting odatda PORT ni o'zi beradi
PORT=8080

# ====== LIBREOFFICE ======
# Odatda yozish shart emas (bot o'zi topadi). Topolmasa, Windows uchun:
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe


# ====== CHEGARALAR ======
MAX_FILE_MB=20
MAX_IMAGES=30
CONVERT_TIMEOUT=180
MAX_PARALLEL=2
SESSION_TTL_MIN=30

# ====== PDF SIFATI (Word/PowerPoint ichidagi rasmlar) ======
# lossless - siqmasdan, piksellar kamaytirilmaydi (eng yuqori sifat, hajm kattaroq bo'lishi mumkin)
# quality  - JPEG sifati 100%, piksellar kamaytirilmaydi (hajm kichikroq)
# default  - LibreOffice standart sozlamasi (rasmlar siqiladi!). Faqat xato bo'lsa sinab ko'ring.
PDF_IMAGE_EXPORT=lossless

# ====== PAPKALAR (ixtiyoriy) ======
# TEMP_DIR=
# LOG_DIR=
